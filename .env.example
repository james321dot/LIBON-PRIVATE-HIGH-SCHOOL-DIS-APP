# LPHS Digital Attendance System — SERVER-ONLY secrets.
#
# Copy to `.env` (or set these in your hosting provider's dashboard / Worker
# secrets). Never commit the real `.env`.
#
# IMPORTANT: these have NO `VITE_` prefix on purpose.
#   * `VITE_*` values are compiled INTO the public JavaScript bundle, so anyone
#     can read them with browser devtools. Never put a password there.
#   * Values with no prefix are read only inside server functions
#     (`src/lib/staff-auth.server.ts`) and never reach the browser.
#
# If a value is unset, that account simply cannot sign in — there is no
# hardcoded fallback password to leak.

# Admin dashboard passcode.
ADMIN_PASSWORD=

# Staff gate passwords.
STAFF_GUARD_PASSWORD=
STAFF_ADMIN_PASSWORD=
STAFF_ECLUB_PASSWORD=
STAFF_DEV_PASSWORD=

# --- Firebase service account (for minting custom auth tokens) ---
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key. These two values are HIGHLY sensitive: they let the server mint
# signed login tokens. Server-only, never `VITE_`-prefixed.
#
# FIREBASE_PRIVATE_KEY should be the PEM block. If your host stores env vars on
# one line, keep the \n escapes — the server converts them back to newlines.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Public values (safe to expose, hence the VITE_ prefix).
# ---------------------------------------------------------------------------

# Canonical origin used in sitemap.xml. When empty, the live request origin is
# used automatically (correct for previews and custom domains).
VITE_SITE_URL=
